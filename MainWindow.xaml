<Window x:Class="DynamicIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="灵动岛"
        Width="576" Height="314"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        Topmost="True"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Grayscale"
        FontFamily="Microsoft YaHei UI, Segoe UI">

    <Window.Resources>
        <Style x:Key="TransportGlyph" TargetType="TextBlock">            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <!-- 底栏的"消息 / 待办"切换按钮 -->
        <Style x:Key="TabButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextTertiary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                CornerRadius="7"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#26FFFFFF" />
                                <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 消息行：悬停时浮出完整内容，右上角一个删除按钮 -->
        <Style x:Key="MessageRow" TargetType="Grid">
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style x:Key="DismissButton" TargetType="Button">            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Opacity" Value="0.35" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="#00FFFFFF" CornerRadius="8">
                            <TextBlock Text="&#xE711;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="9"
                                       Foreground="{StaticResource TextSecondary}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#40FFFFFF" />
                                <Setter Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root" Background="{x:Null}">

        <!-- Host 尺寸恒定 = 展开时的大小。收起/展开只动画"剪裁出来的形状"，
             不做布局，所以动画期间没有一帧重排，帧率就稳了。 -->
        <Grid x:Name="Host"
              HorizontalAlignment="Center"
              VerticalAlignment="Top"
              Width="560" Height="292"
              Margin="0,16,0,0">

            <Grid x:Name="Glass">
                <!-- 投影用两层低透明度的暗色描边，比 DropShadowEffect 着色器便宜得多 -->
                <Border CornerRadius="28"
                        Background="#3A000000"
                        Margin="-1"
                        IsHitTestVisible="False" />

                <!-- 背景层：抓屏 → 缩小 → CPU 盒子模糊 → 线性放大，真正做到"透出背后画面" -->
                <Canvas x:Name="BackdropCanvas" ClipToBounds="False">
                    <Image x:Name="BackdropImage"
                           Stretch="Fill"
                           RenderOptions.BitmapScalingMode="Linear"
                           RenderTransformOrigin="0,0">
                        <Image.RenderTransform>
                            <!-- 岛整体缩放时用它反向补偿，保证底图和屏幕仍然 1:1 对齐 -->
                            <ScaleTransform x:Name="BackdropCounterScale" ScaleX="1" ScaleY="1" />
                        </Image.RenderTransform>
                    </Image>
                </Canvas>

                <Rectangle x:Name="TintRect"
                           Fill="{StaticResource GlassTint}"
                           IsHitTestVisible="False" />

                <Rectangle x:Name="SheenRect"
                           Height="70"
                           VerticalAlignment="Top"
                           Fill="{StaticResource GlassSheen}"
                           IsHitTestVisible="False" />

                <Rectangle x:Name="TopHighlight"
                           Height="1"
                           VerticalAlignment="Top"
                           Margin="1,0"
                           Fill="{StaticResource GlassTopHighlight}"
                           IsHitTestVisible="False" />

                <Border x:Name="GlassBorder"
                        BorderBrush="{StaticResource GlassBorder}"
                        BorderThickness="1"
                        CornerRadius="21"
                        IsHitTestVisible="False" />

                <!-- 计时到点的闪光 -->
                <Rectangle x:Name="TimerFlash"
                           Opacity="0"
                           IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#00FFD166" Offset="0" />
                            <GradientStop Color="#B3FFD166" Offset="0.5" />
                            <GradientStop Color="#00FFD166" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <!-- ==================== 收起状态 ==================== -->
                <!-- 固定在胶囊那一块区域里，内容自己在其中居中 -->
                <Grid x:Name="CollapsedPanel"
                      Opacity="1"
                      Width="232" Height="42"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Top">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="CollapsedScale" ScaleX="1" ScaleY="1" />
                    </Grid.RenderTransform>
                    <Grid.RenderTransformOrigin>0.5,0.5</Grid.RenderTransformOrigin>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                        <Grid x:Name="MiniEqualizer"
                              Width="13" Height="13"
                              Margin="0,0,9,0"
                              VerticalAlignment="Center"
                              Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <Rectangle x:Name="Bar1" Width="2.5" Height="13" RadiusX="1.25" RadiusY="1.25"
                                           Fill="#FFEB5B5B" RenderTransformOrigin="0.5,1">
                                    <Rectangle.RenderTransform>
                                        <ScaleTransform x:Name="Bar1Scale" ScaleY="1" />
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                                <Rectangle x:Name="Bar2" Width="2.5" Height="13" Margin="2.5,0" RadiusX="1.25" RadiusY="1.25"
                                           Fill="#FFFF8A8A" RenderTransformOrigin="0.5,1">
                                    <Rectangle.RenderTransform>
                                        <ScaleTransform x:Name="Bar2Scale" ScaleY="1" />
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                                <Rectangle x:Name="Bar3" Width="2.5" Height="13" RadiusX="1.25" RadiusY="1.25"
                                           Fill="#FFFFC0C0" RenderTransformOrigin="0.5,1">
                                    <Rectangle.RenderTransform>
                                        <ScaleTransform x:Name="Bar3Scale" ScaleY="1" />
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                            </StackPanel>
                        </Grid>

                        <Ellipse x:Name="IdleDot"
                                 Width="6" Height="6"
                                 Fill="{StaticResource TextSecondary}"
                                 Margin="0,0,9,0"
                                 VerticalAlignment="Center" />

                        <TextBlock x:Name="CollapsedClock"
                                   Text="00:00"
                                   Style="{StaticResource ClockText}"
                                   FontSize="15.5"
                                   VerticalAlignment="Center" />

                        <!-- 计时中：小时间 + 大倒计时 -->
                        <StackPanel x:Name="CollapsedTimerGroup"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed">
                            <Rectangle Width="1" Height="12" Fill="#30FFFFFF"
                                       Margin="9,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="CollapsedTimer"
                                       Text="00:00"
                                       Style="{StaticResource ClockText}"
                                       FontSize="15.5"
                                       Foreground="#FFFFD166"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <Rectangle x:Name="CollapsedSeparator" Width="1" Height="13" Fill="#30FFFFFF"
                                   Margin="10,0" VerticalAlignment="Center" />

                        <Image x:Name="CollapsedWeatherIcon"
                               Width="16" Height="16"
                               VerticalAlignment="Center"
                               Margin="0,0,4,0" />

                        <TextBlock x:Name="CollapsedTemp"
                                   Text="--°"
                                   FontSize="13.5"
                                   Foreground="{StaticResource TextSecondary}"
                                   VerticalAlignment="Center" />

                        <!-- 收起时也显示 CPU（可选） -->
                        <TextBlock x:Name="CollapsedCpu"
                                   Text=""
                                   FontSize="11.5"
                                   Visibility="Collapsed"
                                   VerticalAlignment="Center"
                                   Margin="9,0,0,0" />
                    </StackPanel>
                </Grid>

                <!-- ==================== 展开状态 ==================== -->
                <Grid x:Name="ExpandedPanel"
                      Opacity="0"
                      Visibility="Collapsed"
                      Margin="18">
                    <!-- 展开内容围绕岛中心缩放：收起时"缩回"胶囊里 -->
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="ExpandedScale" ScaleX="1" ScaleY="1" />
                    </Grid.RenderTransform>
                    <Grid.RenderTransformOrigin>0.5,0.14</Grid.RenderTransformOrigin>

                    <Grid x:Name="NormalContent">
                        <Grid.RowDefinitions>
                            <RowDefinition x:Name="HeaderRow" Height="62" />
                            <RowDefinition x:Name="Gap1Row" Height="8" />
                            <RowDefinition x:Name="MusicRow" Height="76" />
                            <RowDefinition x:Name="Gap2Row" Height="8" />
                            <RowDefinition x:Name="MessageRow" Height="102" />
                        </Grid.RowDefinitions>

                        <!-- 时间 / 倒计时 + 天气 -->
                        <Grid Grid.Row="0">
                            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                    <TextBlock x:Name="HeaderClock"
                                               Text="00:00"
                                               Style="{StaticResource ClockText}"
                                               FontSize="34"
                                               LineHeight="36"
                                               VerticalAlignment="Bottom" />

                                    <TextBlock x:Name="TimerBig"
                                               Text="00:00"
                                               Style="{StaticResource ClockText}"
                                               FontSize="34"
                                               LineHeight="36"
                                               Margin="8,0,0,0"
                                               Foreground="#FFFFD166"
                                               VerticalAlignment="Bottom"
                                               Visibility="Collapsed" />
                                </StackPanel>

                                <TextBlock x:Name="HeaderSub"
                                           Text="—"
                                           Style="{StaticResource CaptionText}"
                                           Margin="2,2,0,0" />

                                <!-- 计时进度条 -->
                                <Grid x:Name="TimerTrack"
                                      Height="3"
                                      Width="180"
                                      HorizontalAlignment="Left"
                                      Margin="2,5,0,0"
                                      Visibility="Collapsed"
                                      ClipToBounds="True">
                                    <Rectangle RadiusX="1.5" RadiusY="1.5" Fill="#33FFFFFF" />
                                    <Rectangle x:Name="TimerTrackFill"
                                               RadiusX="1.5" RadiusY="1.5"
                                               Fill="#FFFFD166"
                                               RenderTransformOrigin="0,0.5">
                                        <Rectangle.RenderTransform>
                                            <ScaleTransform x:Name="TimerTrackScale" ScaleX="1" />
                                        </Rectangle.RenderTransform>
                                    </Rectangle>
                                </Grid>
                            </StackPanel>

                            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Orientation="Horizontal">

                                <!-- CPU / 内存 -->
                                <StackPanel x:Name="PerfBlock"
                                            VerticalAlignment="Center"
                                            Margin="0,0,14,0">
                                    <TextBlock x:Name="CpuText"
                                               Text="CPU --"
                                               FontSize="10.5"
                                               HorizontalAlignment="Right"
                                               Foreground="{StaticResource TextSecondary}" />
                                    <TextBlock x:Name="MemText"
                                               Text="内存 --"
                                               FontSize="10.5"
                                               HorizontalAlignment="Right"
                                               Margin="0,2,0,0"
                                               Foreground="{StaticResource TextSecondary}" />
                                </StackPanel>

                                <!-- 可见的入口：计时 / 设置 -->
                                <Button x:Name="TimerButton"
                                        Style="{StaticResource GlassIconButton}"
                                        Width="28" Height="28"
                                        Margin="0,0,6,0"
                                        Focusable="False"
                                        ToolTip="倒计时 / 闹钟">
                                    <TextBlock Text="&#xE916;" FontSize="13"
                                               Style="{StaticResource TransportGlyph}" />
                                </Button>
                                <Button x:Name="SettingsButton"
                                        Style="{StaticResource GlassIconButton}"
                                        Width="28" Height="28"
                                        Margin="0,0,10,0"
                                        Focusable="False"
                                        ToolTip="设置">
                                    <TextBlock Text="&#xE713;" FontSize="13"
                                               Style="{StaticResource TransportGlyph}" />
                                </Button>

                                <!-- 点这里打开天气网页 -->
                                <StackPanel x:Name="WeatherBlock"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Cursor="Hand"
                                            Background="Transparent"
                                            ToolTip="点击打开天气网页">
                                    <Image x:Name="WeatherIcon"
                                           Width="36" Height="36"
                                           VerticalAlignment="Center" />
                                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="WeatherTemp"
                                                   Text="--°"
                                                   Style="{StaticResource ClockText}"
                                                   FontSize="23" />
                                        <TextBlock x:Name="WeatherDesc"
                                                   Text="天气加载中"
                                                   Style="{StaticResource CaptionText}"
                                                   Margin="1,1,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- 音乐 -->
                        <Border x:Name="MusicCard"
                                Grid.Row="2"
                                CornerRadius="16"
                                Background="#16FFFFFF"
                                Padding="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0" Width="56" Height="56">
                                    <Border CornerRadius="14" ClipToBounds="True">
                                        <Border.Background>
                                            <ImageBrush x:Name="ArtworkBrush" Stretch="UniformToFill" />
                                        </Border.Background>
                                    </Border>
                                    <Border x:Name="ArtworkPlaceholder"
                                            CornerRadius="14"
                                            Background="#1FFFFFFF">
                                        <TextBlock Text="♪"
                                                   FontSize="24"
                                                   Foreground="{StaticResource TextTertiary}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                </Grid>

                                <Grid Grid.Column="1" Margin="12,0,10,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" VerticalAlignment="Center">
                                        <TextBlock x:Name="TrackTitle"
                                                   Text="没有正在播放的音乐"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="TrackArtist"
                                                   Text=""
                                                   FontSize="11.5"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>

                                    <Grid Grid.Row="1" Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border x:Name="TrackSourceChip"
                                                Grid.Column="0"
                                                Background="#1FFFFFFF"
                                                CornerRadius="6"
                                                Padding="6,1.5">
                                            <TextBlock x:Name="TrackSource"
                                                       Text="媒体"
                                                       FontSize="10"
                                                       Foreground="{StaticResource TextSecondary}" />
                                        </Border>

                                        <!-- 进度条：可以按住拖动跳转 -->
                                        <Border x:Name="ProgressHit"
                                                Grid.Column="1"
                                                Height="14"
                                                Margin="6,0"
                                                Background="Transparent"
                                                VerticalAlignment="Center"
                                                Cursor="Hand"
                                                ToolTip="按住拖动可跳转">
                                            <Border Height="3"
                                                    CornerRadius="1.5"
                                                    Background="#26FFFFFF"
                                                    VerticalAlignment="Center"
                                                    ClipToBounds="True">
                                                <Rectangle x:Name="ProgressFill"
                                                           Fill="{StaticResource AccentMusic}"
                                                           RadiusX="1.5" RadiusY="1.5"
                                                           RenderTransformOrigin="0,0.5">
                                                    <Rectangle.RenderTransform>
                                                        <ScaleTransform x:Name="ProgressScale" ScaleX="0" />
                                                    </Rectangle.RenderTransform>
                                                </Rectangle>
                                            </Border>
                                        </Border>

                                        <TextBlock Grid.Column="2"
                                                   x:Name="TrackTime"
                                                   Text="0:00"
                                                   FontSize="10"
                                                   Foreground="{StaticResource TextTertiary}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Grid>

                                <StackPanel Grid.Column="2"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Button x:Name="PrevButton"
                                            Style="{StaticResource GlassIconButton}"
                                            Width="30" Height="30"
                                            Focusable="False"
                                            ToolTip="上一首">
                                        <TextBlock Text="&#xE892;" FontSize="13"
                                                   Style="{StaticResource TransportGlyph}" />
                                    </Button>
                                    <Button x:Name="PlayPauseButton"
                                            Style="{StaticResource GlassIconButton}"
                                            Width="38" Height="38"
                                            Margin="7,0"
                                            Focusable="False"
                                            ToolTip="播放 / 暂停"
                                            Background="#2EFFFFFF">
                                        <TextBlock x:Name="PlayPauseGlyph" Text="&#xE768;" FontSize="15"
                                                   Style="{StaticResource TransportGlyph}" />
                                    </Button>
                                    <Button x:Name="NextButton"
                                            Style="{StaticResource GlassIconButton}"
                                            Width="30" Height="30"
                                            Focusable="False"
                                            ToolTip="下一首">
                                        <TextBlock Text="&#xE893;" FontSize="13"
                                                   Style="{StaticResource TransportGlyph}" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 消息 / 待办：高度固定两行，多了滚轮看 -->
                        <Border x:Name="MessagesCard"
                                Grid.Row="4"
                                CornerRadius="14"
                                Background="#12FFFFFF"
                                Padding="10,6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <!-- 列表固定两行；底栏留够高度，页签文字才不会被截 -->
                                    <RowDefinition Height="64" />
                                    <RowDefinition Height="26" />
                                </Grid.RowDefinitions>

                                <!-- ===== 消息列表 ===== -->
                                <ScrollViewer x:Name="MessageScroll"
                                              Grid.Row="0"
                                              VerticalScrollBarVisibility="Hidden"
                                              HorizontalScrollBarVisibility="Disabled"
                                              PanningMode="VerticalOnly"
                                              CanContentScroll="False"
                                              Focusable="False">
                                    <ItemsControl x:Name="MessageList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Style="{StaticResource MessageRow}"
                                                      Background="Transparent"
                                                      ToolTipService.InitialShowDelay="300"
                                                      ToolTipService.ShowDuration="4000">
                                                    <Grid.ToolTip>
                                                        <ToolTip Background="#F217181D"
                                                                 BorderBrush="#33FFFFFF"
                                                                 BorderThickness="1"
                                                                 Padding="10,8"
                                                                 MaxWidth="380">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding TooltipTitle}"
                                                                           FontSize="12.5"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="White"
                                                                           TextWrapping="Wrap" />
                                                                <TextBlock Text="{Binding TooltipBody}"
                                                                           FontSize="11.5"
                                                                           Foreground="#D6FFFFFF"
                                                                           TextWrapping="Wrap"
                                                                           Margin="0,5,0,0" />
                                                                <TextBlock Text="{Binding SourceAndTime}"
                                                                           FontSize="10"
                                                                           Foreground="#8CFFFFFF"
                                                                           Margin="0,6,0,0" />
                                                            </StackPanel>
                                                        </ToolTip>
                                                    </Grid.ToolTip>

                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0"
                                                            Width="26" Height="26"
                                                            CornerRadius="8"
                                                            Background="{Binding BadgeBrush}"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding BadgeText}"
                                                                   FontSize="10"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="White"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                    </Border>

                                                    <StackPanel Grid.Column="1"
                                                                Margin="10,0,8,0"
                                                                VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DisplayTitle}"
                                                                   FontSize="12.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextPrimary}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding DisplayText}"
                                                                   FontSize="10.5"
                                                                   Foreground="{StaticResource TextTertiary}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Margin="0,1,0,0" />
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding TimeText}"
                                                               FontSize="10"
                                                               Foreground="{StaticResource TextTertiary}"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,6,0" />

                                                    <Button Grid.Column="3"
                                                            Style="{StaticResource DismissButton}"
                                                            VerticalAlignment="Center"
                                                            Tag="{Binding}"
                                                            Click="OnDismissMessage"
                                                            ToolTip="从岛上移除这条" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <!-- ===== 待办列表 ===== -->
                                <ScrollViewer x:Name="TodoScroll"
                                              Grid.Row="0"
                                              VerticalScrollBarVisibility="Hidden"
                                              HorizontalScrollBarVisibility="Disabled"
                                              PanningMode="VerticalOnly"
                                              CanContentScroll="False"
                                              Focusable="False"
                                              Visibility="Collapsed">
                                    <ItemsControl x:Name="TodoList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Height="30" Margin="0,1" Opacity="{Binding RowOpacity}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- 点这里切换完成 -->
                                                    <Button Grid.Column="0"
                                                            Width="24" Height="24"
                                                            VerticalAlignment="Center"
                                                            Focusable="False"
                                                            Cursor="Hand"
                                                            Tag="{Binding}"
                                                            Click="OnToggleTodo"
                                                            ToolTip="标记完成 / 取消">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="Box"
                                                                        CornerRadius="7"
                                                                        Background="{Binding BoxBackground}"
                                                                        BorderBrush="{Binding BoxBorder}"
                                                                        BorderThickness="1.4">
                                                                    <TextBlock Text="{Binding CheckGlyph}"
                                                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                                               FontSize="12"
                                                                               FontWeight="Bold"
                                                                               Foreground="#FF17240F"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center" />
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Box" Property="BorderBrush" Value="#CCFFFFFF" />
                                                                        <Setter TargetName="Box" Property="Background" Value="#33FFFFFF" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>

                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Text}"
                                                               FontSize="12.5"
                                                               Foreground="{Binding TextBrush}"
                                                               TextDecorations="{Binding Decorations}"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center"
                                                               Margin="10,0,8,0" />

                                                    <Button Grid.Column="2"
                                                            Style="{StaticResource DismissButton}"
                                                            VerticalAlignment="Center"
                                                            Tag="{Binding}"
                                                            Click="OnDeleteTodo"
                                                            ToolTip="删除这条待办" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <TextBlock x:Name="TodoEmpty"
                                           Grid.Row="0"
                                           Text="还没有待办。点右下角「+」加一条"
                                           FontSize="12"
                                           Foreground="{StaticResource TextTertiary}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed" />

                                <!-- 底栏：左边切换 消息 / 待办，右边提示 -->
                                <Grid Grid.Row="1" VerticalAlignment="Center">
                                    <!-- 一条细分隔线，让页签区看起来是独立的一条 -->
                                    <Rectangle Height="1" Fill="#1FFFFFFF"
                                               VerticalAlignment="Top"
                                               Margin="-10,0,-10,0" />

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Margin="0,7,0,0">
                                        <Button x:Name="MessagesTab"
                                                Style="{StaticResource TabButton}"
                                                Content="消息"
                                                FontSize="11"
                                                Padding="9,3"
                                                Margin="0,0,4,0"
                                                Click="OnShowMessages" />
                                        <Button x:Name="TodosTab"
                                                Style="{StaticResource TabButton}"
                                                Content="待办"
                                                FontSize="11"
                                                Padding="9,3"
                                                Margin="0,0,6,0"
                                                Click="OnShowTodos" />
                                        <Button x:Name="AddTodoButton"
                                                Style="{StaticResource TabButton}"
                                                Content="+ 添加"
                                                FontSize="11"
                                                Padding="9,3"
                                                Visibility="Collapsed"
                                                Click="OnAddTodo"
                                                ToolTip="添加一条待办" />
                                    </StackPanel>

                                    <TextBlock x:Name="MessageCountText"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Margin="0,7,0,0"
                                               FontSize="10"
                                               Foreground="{StaticResource TextTertiary}" />
                                    <TextBlock x:Name="MoreHintText"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Margin="0,7,110,0"
                                               FontSize="10"
                                               Foreground="{StaticResource TextSecondary}" />
                                </Grid>

                                <TextBlock x:Name="MessageEmpty"
                                           Grid.Row="0"
                                           Text="暂无未读消息"
                                           FontSize="12"
                                           Foreground="{StaticResource TextTertiary}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
