<Window x:Class="DynamicIsland.InputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加待办"
        Width="400" SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Grayscale"
        FontFamily="Microsoft YaHei UI, Segoe UI">

    <Border Style="{StaticResource DialogRoot}">
        <Grid>
            <Rectangle Style="{StaticResource DialogTopGlow}" />

            <StackPanel Margin="0,14,0,20">
                <Grid Style="{StaticResource DialogTitleBar}" MouseLeftButtonDown="OnTitleBarDrag">
                    <TextBlock x:Name="TitleText" Text="添加待办" Style="{StaticResource DialogTitle}" />
                    <Button Style="{StaticResource DialogClose}" Click="OnCancel" />
                </Grid>

                <StackPanel Margin="20,6,20,0">
                    <TextBlock x:Name="PromptText" Text="要做什么？"
                               Style="{StaticResource DlgHint}" Margin="0,0,0,8" />

                    <TextBox x:Name="InputBox" Style="{StaticResource DlgTextBox}" Padding="11,9"
                             FontSize="13.5" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                        <Button Style="{StaticResource DlgButton}" Content="取消"
                                Margin="0,0,8,0" Click="OnCancel" />
                        <Button Style="{StaticResource DlgPrimaryButton}" Content="添加"
                                IsDefault="True" Click="OnConfirm" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
