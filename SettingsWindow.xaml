<Window x:Class="DynamicIsland.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="灵动岛设置"
        Width="580" Height="660"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Grayscale"
        FontFamily="Microsoft YaHei UI, Segoe UI">

    <Border Style="{StaticResource DialogRoot}">
        <Grid>
            <Rectangle Style="{StaticResource DialogTopGlow}" />

            <Grid Margin="0,14,0,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 标题栏（按住可以拖窗口） -->
                <Grid Grid.Row="0" Style="{StaticResource DialogTitleBar}"
                      Background="Transparent"
                      MouseLeftButtonDown="OnTitleBarDrag">
                    <TextBlock Text="设置" Style="{StaticResource DialogTitle}" />
                    <Button Style="{StaticResource DialogClose}" Click="OnCloseChrome" />
                </Grid>

                <ScrollViewer Grid.Row="1" Margin="20,4,14,0" VerticalScrollBarVisibility="Auto"
                              Padding="0,0,6,0">
                    <StackPanel>

                        <!-- 天气定位 -->
                        <Border Style="{StaticResource DlgCard}">
                            <StackPanel>
                                <TextBlock Text="天气定位" Style="{StaticResource DlgSection}" />
                                <TextBlock Style="{StaticResource DlgHint}"
                                           Text="默认按公网 IP 定位。IP 库有时会把城市认错（比如把福州认成广州），定位不准就在这里手填城市名，手填的优先。"
                                           Margin="0,0,0,10" />

                                <CheckBox x:Name="AutoLocateCheck" Style="{StaticResource DlgCheckBox}"
                                          Content="没手填时按 IP 自动定位"
                                          Checked="OnToggleChanged" Unchecked="OnToggleChanged" />

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="82" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="手动城市" Style="{StaticResource DlgLabel}" />
                                    <TextBox x:Name="CityBox" Grid.Column="1"
                                             Style="{StaticResource DlgTextBox}"
                                             Padding="10,7"
                                             ToolTip="例如：福州、厦门、北京" />
                                </Grid>

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="82" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="刷新间隔" Style="{StaticResource DlgLabel}" />
                                    <Slider x:Name="WeatherRefreshSlider" Grid.Column="1"
                                            Style="{StaticResource DlgSlider}"
                                            Minimum="15" Maximum="180" TickFrequency="5"
                                            IsSnapToTickEnabled="True"
                                            ValueChanged="OnAppearanceChanged" />
                                    <TextBlock x:Name="WeatherRefreshValue" Grid.Column="2"
                                               Style="{StaticResource DlgValue}" Width="54" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 外观 -->
                        <Border Style="{StaticResource DlgCard}">
                            <StackPanel>
                                <TextBlock Text="外观" Style="{StaticResource DlgSection}" />

                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="82" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="距离顶部" Style="{StaticResource DlgLabel}" />
                                    <Slider x:Name="TopOffsetSlider" Grid.Column="1"
                                            Style="{StaticResource DlgSlider}"
                                            Minimum="0" Maximum="80" TickFrequency="1" IsSnapToTickEnabled="True"
                                            ValueChanged="OnAppearanceChanged" />
                                    <TextBlock x:Name="TopOffsetValue" Grid.Column="2" Style="{StaticResource DlgValue}" />
                                </Grid>

                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="82" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="模糊强度" Style="{StaticResource DlgLabel}" />
                                    <Slider x:Name="BlurSlider" Grid.Column="1"
                                            Style="{StaticResource DlgSlider}"
                                            Minimum="8" Maximum="64" TickFrequency="1" IsSnapToTickEnabled="True"
                                            ValueChanged="OnAppearanceChanged" />
                                    <TextBlock x:Name="BlurValue" Grid.Column="2" Style="{StaticResource DlgValue}" />
                                </Grid>

                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="82" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="通透度" Style="{StaticResource DlgLabel}" />
                                    <Slider x:Name="TintSlider" Grid.Column="1"
                                            Style="{StaticResource DlgSlider}"
                                            Minimum="0.2" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                            ValueChanged="OnAppearanceChanged" />
                                    <TextBlock x:Name="TintValue" Grid.Column="2" Style="{StaticResource DlgValue}" />
                                </Grid>

                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="82" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="消息停留" Style="{StaticResource DlgLabel}" />
                                    <Slider x:Name="HoldSlider" Grid.Column="1"
                                            Style="{StaticResource DlgSlider}"
                                            Minimum="1000" Maximum="8000" TickFrequency="200" IsSnapToTickEnabled="True"
                                            ValueChanged="OnAppearanceChanged" />
                                    <TextBlock x:Name="HoldValue" Grid.Column="2" Style="{StaticResource DlgValue}" />
                                </Grid>

                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="82" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="背景刷新" Style="{StaticResource DlgLabel}" />
                                    <Slider x:Name="RefreshSlider" Grid.Column="1"
                                            Style="{StaticResource DlgSlider}"
                                            Minimum="0" Maximum="5000" TickFrequency="100" IsSnapToTickEnabled="True"
                                            ValueChanged="OnAppearanceChanged" />
                                    <TextBlock x:Name="RefreshValue" Grid.Column="2" Style="{StaticResource DlgValue}" />
                                </Grid>

                                <TextBlock Style="{StaticResource DlgHint}" Margin="0,8,0,0"
                                           Text="鼠标一移开就立刻收起；「消息停留」是来新消息后岛主动展开的时长。背景刷新 0 = 只在展开/收起时抓一次。" />
                            </StackPanel>
                        </Border>

                        <!-- 显示内容 / 大小 -->
                        <Border Style="{StaticResource DlgCard}">
                            <StackPanel>
                                <TextBlock Text="显示内容与大小" Style="{StaticResource DlgSection}" />

                                <Grid Margin="0,4,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="82" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="岛的大小" Style="{StaticResource DlgLabel}" />
                                    <Slider x:Name="ScaleSlider" Grid.Column="1"
                                            Style="{StaticResource DlgSlider}"
                                            Minimum="0.7" Maximum="1.6" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                            ValueChanged="OnAppearanceChanged" />
                                    <TextBlock x:Name="ScaleValue" Grid.Column="2" Style="{StaticResource DlgValue}" />
                                </Grid>

                                <CheckBox x:Name="ShowMusicCheck" Style="{StaticResource DlgCheckBox}"
                                          Content="显示音乐卡片"
                                          Checked="OnToggleChanged" Unchecked="OnToggleChanged" />
                                <CheckBox x:Name="ShowMessagesCheck" Style="{StaticResource DlgCheckBox}"
                                          Content="显示消息 / 待办卡片"
                                          Checked="OnToggleChanged" Unchecked="OnToggleChanged" />
                                <CheckBox x:Name="ShowTodosCheck" Style="{StaticResource DlgCheckBox}"
                                          Content="显示待办页签"
                                          Checked="OnToggleChanged" Unchecked="OnToggleChanged" />
                                <CheckBox x:Name="ShowWeatherCheck" Style="{StaticResource DlgCheckBox}"
                                          Content="显示天气（点它打开天气网页）"
                                          Checked="OnToggleChanged" Unchecked="OnToggleChanged" />
                                <CheckBox x:Name="ShowPerformanceCheck" Style="{StaticResource DlgCheckBox}"
                                          Content="显示 CPU / 内存占用"
                                          Checked="OnToggleChanged" Unchecked="OnToggleChanged" />
                                <CheckBox x:Name="PerfInPillCheck" Style="{StaticResource DlgCheckBox}"
                                          Content="收缩成小胶囊时也显示 CPU"
                                          Checked="OnToggleChanged" Unchecked="OnToggleChanged" />
                                <CheckBox x:Name="MemoryDetailCheck" Style="{StaticResource DlgCheckBox}"
                                          Content="内存显示已用 / 总量"
                                          Checked="OnToggleChanged" Unchecked="OnToggleChanged" />
                            </StackPanel>
                        </Border>

                        <!-- 功能开关 -->
                        <Border Style="{StaticResource DlgCard}">
                            <StackPanel>
                                <TextBlock Text="功能" Style="{StaticResource DlgSection}" />
                                <CheckBox x:Name="AutoStartCheck" Style="{StaticResource DlgCheckBox}"
                                          Content="开机自动启动"
                                          Checked="OnToggleChanged" Unchecked="OnToggleChanged" />
                                <CheckBox x:Name="QqCallCheck" Style="{StaticResource DlgCheckBox}"
                                          Content="监听 QQ 窗口消息"
                                          Checked="OnToggleChanged" Unchecked="OnToggleChanged" />
                                <CheckBox x:Name="ExcludeCheck" Style="{StaticResource DlgCheckBox}"
                                          Content="截图 / 录屏时隐藏灵动岛（需重启）"
                                          Checked="OnToggleChanged" Unchecked="OnToggleChanged" />
                            </StackPanel>
                        </Border>

                        <!-- 位置 -->
                        <Border Style="{StaticResource DlgCard}">
                            <StackPanel>
                                <TextBlock Text="位置" Style="{StaticResource DlgSection}" />
                                <TextBlock Style="{StaticResource DlgHint}" Margin="0,0,0,10"
                                           Text="直接按住岛身空白处就能拖动它。这里可以把位置清掉，回到顶部居中。" />
                                <Button x:Name="ResetPositionButton" Style="{StaticResource DlgButton}"
                                        Content="复位到顶部居中" HorizontalAlignment="Left"
                                        Click="OnResetPosition" />
                            </StackPanel>
                        </Border>

                        <!-- 推送接口 -->
                        <Border Style="{StaticResource DlgCard}">
                            <StackPanel>
                                <TextBlock Text="本地推送接口" Style="{StaticResource DlgSection}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="82" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="端口（0=关）" Style="{StaticResource DlgLabel}" />
                                    <TextBox x:Name="PortBox" Grid.Column="1"
                                             Style="{StaticResource DlgTextBox}" Padding="10,7" />
                                </Grid>
                                <TextBlock Style="{StaticResource DlgHint}" Margin="0,8,0,0"
                                           Text="示例：Invoke-RestMethod -Uri http://127.0.0.1:7788/message -Method Post -Body '{&quot;title&quot;:&quot;构建&quot;,&quot;text&quot;:&quot;成功&quot;}'" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- 底栏 -->
                <Grid Grid.Row="2" Margin="20,10,20,0">
                    <TextBlock x:Name="HintText" Style="{StaticResource DlgHint}"
                               VerticalAlignment="Center" MaxWidth="280" HorizontalAlignment="Left" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource DlgButton}" Content="恢复默认"
                                Margin="0,0,8,0" Click="OnResetDefaults" />
                        <Button Style="{StaticResource DlgPrimaryButton}" Content="完成" Click="OnSave" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
